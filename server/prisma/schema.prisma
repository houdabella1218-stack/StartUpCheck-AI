// StartUpCheck AI - schema de base de donnees (SQLite)
// Documentation : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Une analyse de viabilite enregistree.
model Analysis {
  id          String @id @default(cuid())
  projectName String
  description String
  sector      String
  sectorLabel String
  market      String
  marketLabel String
  targetClients String
  budget      Float
  currency    String @default("MAD")

  globalScore Int
  verdict     String
  verdictLabel String
  riskLevel   String
  engine      String

  // Blocs serialises en JSON (SQLite ne gere pas les tableaux natifs)
  scoresJson          String
  swotJson            String
  recommendationsJson String
  metaJson            String

  createdAt DateTime @default(now())

  /// Analyses financieres previsionnelles rattachees (0..N)
  financialChecks FinancialCheck[]

  /// Etudes de projet structurees rattachees (0..N versions)
  projectStudies ProjectStudy[]

  @@index([createdAt])
}

/// Analyse financiere previsionnelle (module "Financial Check").
/// Rattachable a une analyse de viabilite existante (analysisId optionnel).
/// Les calculs sont 100 % deterministes : hypotheses + resultats sont figes ici.
model FinancialCheck {
  id         String    @id @default(cuid())
  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  currency String @default("MAD")

  // --- Hypotheses saisies (source de verite) ---
  initialInvestment   Float
  unitPrice           Float
  monthlyUnits        Float
  fixedCostsMonthly   Float
  variableCostPerUnit Float

  // --- Indicateur de sante financiere (deterministe) ---
  healthStatus String
  healthScore  Int

  // --- Resultats figes au moment de l'enregistrement (scenario realiste) ---
  monthlyResult          Float
  annualResult           Float
  contributionMarginRate Float
  breakEvenRevenue       Float?
  breakEvenUnits         Float?
  roiAnnual              Float?
  paybackMonths          Float?

  // --- Detail complet (transparence + reproductibilite) ---
  assumptionsJson String
  computedJson    String
  scenariosJson   String
  metaJson        String

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([createdAt])
}

/// Etude de projet structuree (module "Etude de projet").
/// Plusieurs versions peuvent coexister pour une meme analyse ; une seule
/// version est marquee "isCurrent". Les calculs sont deterministes et les
/// textes generes localement ou par LLM (jamais les chiffres).
model ProjectStudy {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  /// Nom du projet au moment de la generation (historique lisible)
  projectName String

  /// Numero de version, incremente a chaque regeneration (1, 2, 3...)
  version   Int
  /// Version active affichee par defaut
  isCurrent Boolean @default(true)

  /// Statut de faisabilite : viable | viable_sous_conditions | a_retravailler
  feasibilityStatus String
  feasibilityScore  Int
  completenessScore Int

  /// Moteur ayant produit l'etude : local | llm
  engine             String
  methodologyVersion String

  /// Sections, risques, feuille de route et metadonnees (JSON serialise)
  sectionsJson String
  risksJson    String
  roadmapJson  String
  metaJson     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([analysisId, version])
  @@index([analysisId])
  @@index([createdAt])
}
